+    ['1.250,50', 1250.5],
+    ['37.5', 37.5], // bug antigo: virava 375
+    ['6.20', 6.2],
+    ['1.250', 1250], // 3 casas depois do ponto = milhar (pt-BR)
+    ['1.250.000', 1250000],
+    ['0.125', 0.125],
